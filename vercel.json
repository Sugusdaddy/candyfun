{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/cron/tick/route.ts": {
      "maxDuration": 300
    },
    "app/api/launch/submit/route.ts": {
      "maxDuration": 90
    }
  }
}
