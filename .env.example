# Copy to .env.local. Nothing here is secret except the three keys at the bottom.

# ── public ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3900
# From `npm run platform -- --send` (the LaunchLab platform config and the wallet that pays the airdrop)
NEXT_PUBLIC_PLATFORM_ID=
NEXT_PUBLIC_FEE_WALLET=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=
# Every coin starts at this market cap (USD) and graduates at START × MULTIPLE
NEXT_PUBLIC_START_MCAP_USD=20000
NEXT_PUBLIC_GRAD_MULTIPLE=7.5

# ── server ────────────────────────────────────────────────────────────────
# A Helius RPC URL (the keeper uses its DAS API for holder snapshots). Server side only:
# the browser talks to /api/rpc, never to this URL.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Redis in production. For local runs use the in-memory store instead:
REDIS_URL=
KV_MEMORY=1
# Local runs: skip Arweave uploads and serve metadata from /api/meta
FAKE_UPLOADS=1
# Protects /api/cron/tick (call it every minute with `Authorization: Bearer <this>`)
CRON_SECRET=

# ── keys (never commit) ───────────────────────────────────────────────────
# Base58 or JSON array. `npm run keygen` writes them to keys/ (gitignored); local CLI runs read them from there.
FEE_WALLET_KEY=
IRYS_KEY=
